{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@phi-kit/*": [
        "../phi-kit/src/*"
      ],
      "@pui": [
        "../../src"
      ],
      "@pui/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src",
    "../phi-kit/src"
  ],
  "exclude": ["../phi-kit/src/**/*.test.ts", "../phi-kit/src/**/*.test.tsx"]
}
