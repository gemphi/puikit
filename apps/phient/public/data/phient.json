    "about": {
      "title": "About Phient",
      "sub": "",
      "blocks": [
        {
          "kind": "prose",
          "lead": "Phient is a digital human that acts on your behalf across the Phiace ecosystem and runs entirely on open models you control.",
          "sections": [
            {
              "title": "What it does",
              "body": "Delegate the functions you hold — quests, hosting, voting, trading within limits — and Phient runs them for you, each with a single approval."
            },
            {
              "title": "Local first",
              "body": "Models run on your machine over localhost. Nothing is sent anywhere unless you ask Phient to use a networked app."
            },
            {
              "title": "Funded by Phisum",
              "body": "Every function Phient runs is logged to your profile and counts toward your Phisum and $SUM rewards."
            }
          ]
        }
      ]
    },
    "faq": {
      "title": "FAQ",
      "sub": "Common questions.",
      "blocks": [
        {
          "kind": "faq",
          "items": [
            {
              "q": "Does my data leave my machine?",
              "a": "No. Models run locally; Phient only touches a networked app when a task you approved needs it."
            },
            {
              "q": "What can it act on?",
              "a": "Only the PFT functions you hold and have approved, each with its own confirmation."
            },
            {
              "q": "Which models?",
              "a": "Open models like phiano and phinet, pulled and served locally."
            },
            {
              "q": "Does Phient need the internet?",
              "a": "Local models run offline. Tasks that touch apps sync when you are online.",
              "gen": true
            },
            {
              "q": "Can it sign for me?",
              "a": "Only in the apps you delegate and only up to your limits.",
              "gen": true
            },
            {
              "q": "Which model should I use?",
              "a": "Start with Phiano for quick tasks and a larger model for long writing.",
              "gen": true
            },
            {
              "q": "Can I see what it did?",
              "a": "Every task has a log with each step and change.",
              "gen": true
            },
            {
              "q": "Can I stop a task?",
              "a": "Yes, from Tasks or by typing stop in the terminal.",
              "gen": true
            }
          ]
        }
      ]
    },
    "platform": {
      "title": "Platform",
      "sub": "The agents your digital human works through: PhiBot runs playbooks, PhiBrd onboards.",
      "blocks": [
        {
