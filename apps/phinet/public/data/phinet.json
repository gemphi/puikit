    "about": {
      "title": "About Phinet",
      "sub": "",
      "blocks": [
        {
          "kind": "prose",
          "lead": "Phinet turns the phase-operator research into something you can run and compose.",
          "sections": [
            {
              "title": "Runs",
              "body": "Launch, watch and compare runs with live metrics."
            },
            {
              "title": "Modules",
              "body": "Operators are modules you can compose into new networks."
            },
            {
              "title": "CLI",
              "body": "Everything the UI does is available from the command line."
            }
          ]
        }
      ]
    },
    "faq": {
      "title": "FAQ",
      "sub": "Common questions.",
      "blocks": [
        {
          "kind": "faq",
          "items": [
            {
              "q": "What is a phase operator?",
              "a": "The core unit of the architecture — see the papers linked in Docs."
            },
            {
              "q": "Can I compose my own?",
              "a": "Yes, from the Modules page or the CLI."
            },
            {
              "q": "How does it relate to phiano?",
              "a": "phiano is a model built on this network."
            },
            {
              "q": "Do I need a big machine?",
              "a": "No. Small runs work on a laptop and large ones use shared nodes.",
              "gen": true
            },
            {
              "q": "What does a run cost?",
              "a": "The CLI shows the estimate before you start. Most small runs cost under 1 SUM.",
              "gen": true
            },
            {
              "q": "Can I keep my runs private?",
              "a": "Yes. Private runs only use your own machine.",
              "gen": true
            },
            {
              "q": "How do I share compute?",
              "a": "Turn on sharing in Network. You can set hours and limits.",
              "gen": true
            },
            {
              "q": "Can modules call each other?",
              "a": "Yes. Composition is the point: chain modules in one run.",
              "gen": true
            }
          ]
        }
      ]
    },
    "platform": {
      "title": "Platform",
      "sub": "PhiCal on the Phient platform: circuits, semantic queries and training runs.",
      "blocks": [
        {
          "kind": "agent",
          "agent": "phical",
          "intro": "List and create circuits, query the semantic space, start a training run (an approval-gated morphism).",
          "presets": [
            {
              "verb": "list_circuits",
              "label": "Circuits",
              "params": {}
            },
            {
              "verb": "create_circuit",
              "label": "New circuit",
              "params": {
