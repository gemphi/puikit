  "about": {
   "title": "About Phiano",
   "sub": "",
   "blocks": [
    {
     "kind": "prose",
     "lead": "Phiano is the open phase language model that runs the ecosystem's assistants.",
     "sections": [
      {
       "title": "Open & local",
       "body": "Pull it and run it on your own machine through Phient; no hosted calls required."
      },
      {
       "title": "Versions",
       "body": "Pin a version for reproducibility; every release is kept and listed."
      },
      {
       "title": "The architecture",
       "body": "A phase-operator network — see the Phinet papers for the details."
      }
     ]
    }
   ]
  },
  "faq": {
   "title": "FAQ",
   "sub": "Common questions.",
   "blocks": [
    {
     "kind": "faq",
     "items": [
      {
       "q": "Can I run it locally?",
       "a": "Yes, through Phient: phient pull phiano."
      },
      {
       "q": "Is it open?",
       "a": "The weights and the papers are open."
      },
      {
       "q": "What uses it?",
       "a": "Phient, Phiace personas and any app that calls a local model."
      }
     ]
    }
   ]
  },
  "api": {
   "title": "API",
   "sub": "Call phiano from your own code.",
   "blocks": [
    {
     "kind": "terminal",
     "title": "",
     "lines": [
      "phiano 4.1 · serving on localhost:11535"
     ],
     "commands": {
      "curl localhost:11535/generate": [
       "{ \"text\": \"Describe Nightfall in one line.\" }",
       "→ \"A club for people who dress for the dark.\""
      ],
      "phiano run phiano": [
       ">>> loaded phiano 4.1. Type a message, /bye to exit."
      ],
      "phiano versions": [
       "4.1   default   2 days ago",
       "4.0             5 weeks ago"
      ]
     }
    },
    {
     "kind": "grid",
     "title": "Endpoints",
     "items": [
      {
       "title": "/generate",
       "sub": "POST",
       "body": "Text in, text out. Streams tokens."
      },
      {
       "title": "/embed",
       "sub": "POST",
       "body": "Vector embeddings for memory and search."
      },
      {
       "title": "/tools",
       "sub": "POST",
       "body": "Tool-use loop for Phient-style agents."
      }
     ]
    }
   ]
