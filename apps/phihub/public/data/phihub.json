    "about": {
      "title": "About Phihub",
      "sub": "",
      "blocks": [
        {
          "kind": "prose",
          "lead": "Phihub is the registry and installer for the Phiace ecosystem.",
          "sections": [
            {
              "title": "Discover",
              "body": "Browse apps, worlds and repositories by category, with install counts and dependencies shown up front."
            },
            {
              "title": "Install & update",
              "body": "Install into your Phiace with one tap; everything stays current from a single Installed view."
            },
            {
              "title": "Open by default",
              "body": "Every listing links to its repository and its Phiora data, so you can read before you install."
            }
          ]
        }
      ]
    },
    "faq": {
      "title": "FAQ",
      "sub": "Common questions.",
      "blocks": [
        {
          "kind": "faq",
          "items": [
            {
              "q": "What can I install?",
              "a": "Apps, worlds and repositories published to the Phiace registry."
            },
            {
              "q": "Are listings open source?",
              "a": "Each listing links its repo; most are open. Licences are shown on the listing."
            },
            {
              "q": "How do updates work?",
              "a": "Installed apps show an update badge and update in place from the Installed view."
            },
            {
              "q": "Who reviews apps?",
              "a": "A rotating panel of members and the Phihub team checks every new version.",
              "gen": true
            },
            {
              "q": "Can I publish my own app?",
              "a": "Yes. Connect a repo, fill in the listing and submit it for review.",
              "gen": true
            },
            {
              "q": "Are installs free?",
              "a": "Most are. Paid apps show the price in SUM before you install.",
              "gen": true
            },
            {
              "q": "Can I remove an app?",
              "a": "Open Installed and choose Remove. Your data stays until you delete it.",
              "gen": true
            },
            {
              "q": "Do worlds work offline?",
              "a": "Installed worlds load from your machine and sync when you are back online.",
              "gen": true
            }
          ]
        }
      ]
    },
    "platform": {
      "title": "Platform",
      "sub": "PhiGit, the git engine on the Phient platform: refs, blobs, trees and commits behind every repository here.",
      "blocks": [
        {
          "kind": "agent",
          "agent": "phigit",
          "intro": "Content-addressed objects, refs and commits. Store a blob, commit it, then read the log.",
          "presets": [
            {
              "verb": "log",
              "label": "Log",
              "params": {
                "ref": "refs/heads/main",
                "max_count": 20
              }
            },
            {
              "verb": "list_refs",
              "label": "Refs",
              "params": {}
            },
            {
              "verb": "store_blob",
              "label": "Store a blob",
              "params": {
                "content": "hello phiace"
              }
            },
            {
              "verb": "commit",
              "label": "Commit",
              "params": {
                "message": "Phihub: first commit",
                "ref": "refs/heads/main"
              }
            }
          ]
        }
      ]
    },
