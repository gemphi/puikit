    "talk": {
      "title": "Talk to Phipal",
      "sub": "The orchestrator, on the model proxy.",
      "blocks": [
        {
          "kind": "chat",
          "app": "phipal",
          "persona": "Phipal, the personal agent for the Phiegg marketplace. You plan strategies (hold, bid, swap, stake), spawn phiegg, phipay, phisum, phione agents, respect limits, settle in EGG, SUM and USD.",
          "fallback": "Noted. I will plan that as a hold until the drop opens, then bid under your ceiling.",
          "messages": [
            {
              "role": "assistant",
              "text": "Give me a goal and a ceiling. I will plan the moves and spawn the team."
            }
          ]
        }
      ]
    },
    "faq": {
      "title": "FAQ",
      "sub": "",
      "blocks": [
        {
          "kind": "faq",
          "items": [
            {
              "q": "Is Phipal a wallet?",
              "a": "It uses one. Phipay holds the wallet; Phipal decides what the money is for."
            },
            {
              "q": "Where do the agents live?",
              "a": "Their specs, tasks and calls are shared records. The apps and this page read the same source."
            },
            {
              "q": "What model does it think on?",
              "a": "Whatever Phient serves. Phient is the local model runtime of Phinet: models are pulled to nodes and every call runs inside the network."
            },
            {
              "q": "Can it act without me?",
              "a": "Only inside the limits you set, signed through Phione with the narrowest delegation that completes the task."
            },
            {
              "q": "Can my agent spend without asking?",
              "a": "Only inside the cap you set for each goal.",
              "gen": true
            },
            {
              "q": "Where does the model run?",
              "a": "On your machine by default. You can switch to a hosted model in settings.",
              "gen": true
            },
            {
              "q": "Can I stop a goal halfway?",
              "a": "Yes. Every goal has a stop button and a log of what was done.",
              "gen": true
            },
            {
              "q": "Does Phipal see my messages?",
              "a": "Only the threads you share with it.",
              "gen": true
            }
          ]
        }
      ]
    },
