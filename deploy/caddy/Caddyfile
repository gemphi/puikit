# /etc/caddy/Caddyfile on the server (EC2 13.63.125.132): HTTPS for every domain, then nginx on :8080 (app/dist-all)
# and Phiora behind it. This file is the source; app/DOMAINS.md says how it goes up (back up, validate, restart at a
# quiet time, never reload). A site is listed only once its name answers 13.63.125.132, so Caddy never asks for a
# certificate it cannot get. Still to add when their DNS points here: boldpups.xyz (drop GoDaddy's parked records),
# once.city, wand.city, acro.city, ora.phiegg.com.

# Pictures, media records, downloads and the library's files, one key each (scripts/media/sync.sh server):
# /srv/phi-cdn/<key>. A file that is there is cached; a picture for a year, a record or a zip for 5 minutes.
(cdn-files) {
	root * /srv/phi-cdn
	@record {
		path *.json
		file
	}
	@picture {
		not path *.json *.zip
		file
	}
	@download {
		path *.zip
		file
	}
	header @record Cache-Control "public, max-age=300"
	header @picture Cache-Control "public, max-age=31536000"
	header @download Cache-Control "public, max-age=300"
	header Access-Control-Allow-Origin *
	file_server
}
# The media store at /cdn/ on any site that shows its pictures.
(cdn) {
	handle_path /cdn/* {
		import cdn-files
	}
}
# The call line: <site>/wrt/<app>/<room> is Phiora's /api/call/<app>/<room>, its event stream passed on as it comes.
(wrt) {
	handle_path /wrt/* {
		rewrite * /api/call{path}
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}
# Everything else: nginx, which serves every app's build at /<key>/ and Phiora at /api/.
(app) {
	encode gzip
	reverse_proxy 127.0.0.1:8080
}

phiegg.com {
	redir / /phiegg/ 302
	import cdn
	import wrt
	import app
}
www.phiegg.com {
	redir https://phiegg.com{uri} 301
}
cdn.phiegg.com {
	import cdn-files
}

phiber.ai {
	redir / /phiber/ 302
	import app
}
www.phiber.ai {
	redir https://phiber.ai{uri} 301
}

phiace.ai {
	redir / /phiace/ 302
	import app
}
www.phiace.ai {
	redir https://phiace.ai{uri} 301
}

phipad.com {
	redir / /phipad/ 302
	import cdn
	import app
}
www.phipad.com, phipad.xyz, www.phipad.xyz {
	redir https://phipad.com{uri} 301
}

