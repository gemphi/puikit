	redir https://phisum.com{uri} 301
}

# No Phiecs page yet: Phiace until there is one.
phiecs.com, www.phiecs.com {
	redir https://phiace.ai/phiace/ 302
}

# The landing is the root itself: the page finds its app by the domain (registry `domain`), not by a /<key>/.
phiogy.com {
	rewrite / /phiogy-home/
	import cdn
	import wrt
	import app
}
www.phiogy.com {
	redir https://phiogy.com{uri} 301
}
# Phiogy's content: downloads (phiogy/), the shared library's files by hash (lib/), the same store as phiegg.com/cdn.
cdn.phiogy.com {
	import cdn-files
}

