{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.mjs\"",
            "statusMessage": "Checking git use",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
