app/phi-kit/dev/.mock-phiora-state.json

# The local media store at the top of the repository: the bucket's contents, built by scripts/media/build_media.py.
# Only that folder: scripts/media and deploy/aws/media are code.
/media/

.terraform/
*.tfstate*

# Club and look art (3.3 GB): kept on disk and in the media store, too large for git
app/phiegg/art/

# Phiegg pictures written by the generators (bold-cities.py, city-life.py, look-files.py, home-pictures.py):
# kept on disk, never in git
app/phiegg/public/home/
app/phiegg/public/look/
app/phiegg/public/world/

# Pictures in any app's public folder: kept on disk and sent to the server, never in git
app/*/public/**/*.webp
app/*/public/**/*.png
app/*/public/**/*.jpg
app/*/public/**/*.jpeg
app/*/public/**/*.gif
app/*/public/**/*.avif
