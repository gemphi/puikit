# Copy to .env and fill in. docker-compose.yml reads these. Never commit the real .env.

# --- Required ---
# Postgres password (used by db and in Phiora's DATABASE_URL).
PHI_PG_PASSWORD=change-me-long-random
# A long random secret that signs delegation tokens. Generate: openssl rand -hex 32
PHI_DELEGATION_SECRET=change-me-openssl-rand-hex-32
# The site origin(s) the auth cookie is scoped to (comma-separated, scheme + host, no trailing slash).
PHI_ORIGINS=https://phiace.com
# The public URL links in emails point back to.
PHI_PUBLIC_URL=https://phiace.com

# --- Access policy ---
# Editors may create/edit any kind (handles or md5 ids, comma-separated).
PHI_EDITORS=noor.hale
# Kinds anyone signed in may create. comment + order let people comment and back rounds.
# Add round,pool,nest,zone,area,offer if you want open raising. Leave UNSET to open all kinds.
PHI_CREATE_KINDS=comment,order

# --- Mail (account verification / password reset) ---
RESEND_API_KEY=
PHI_MAIL_FROM=Phiace <hi@phiace.com>

# --- Chat model (optional; the apps' Talk falls back to a scripted reply when unset) ---
PHI_MODEL_PROVIDER=openai
PHI_MODEL=gpt-4o-mini
PHI_MODEL_KEY=
PHI_MODEL_URL=

# --- Hosting ---
# Host port nginx listens on (put TLS termination in front of it).
PHI_PORT=8080

# --- Backend choice ---
# Which Phiora answers /api/: build the apps with `node build-all.mjs --backend python` to route
# nginx at the FastAPI service (phiora, from the phiadk repo checked out beside this one), or
# default (node). Both run over the same database. puikit is UI only — the API code lives in phiadk.
