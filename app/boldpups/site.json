              }
            ]
          },
          {
            "kind": "prose",
            "lead": "{world.description}",
            "sections": "$cities"
          },
          {
            "kind": "grid",
            "title": "The clubs",
            "items": "$featured",
            "toolbar": false,
            "layout": "grid",
            "ratio": "16/10",
            "mosaic": false,
            "cardFields": 0,
            "cols": 4,
            "minItemWidth": "14rem",
            "more": {
              "label": "See all 16 clubs",
              "view": "clubs"
            }
          }
        ]
      }
    }
  },
  "featured": [
    "w_once_city",
    "w_bozo_city",
    "w_wand_city",
    "w_acro_city"
