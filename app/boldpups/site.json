{
  "_": "The Bold Pups site (boldpups.xyz) as data. scripts/world-site.mjs fills the placeholders ($tokens, $teaser, $stats, $cities, {club.x}, {world.x}, {n}) from the trait sheet, Phiegg's club and world records and the media store, and writes public/data/boldpups.json. Edit here, then run: node scripts/world-site.mjs boldpups",
  "key": "boldpups",
  "club": "c_bp",
  "sheet": "media/incoming/bpwc",
  "token": {
    "number": "Number",
    "title": "BOLD PUP #{n}",
    "sub": "Club",
    "facet": "Club",
    "lead": "picture"
  },
  "field": {
    "g": "Glasses",
    "Hair Colour": "Hair colour",
    "Char": "Character",
    "Hair": "Hair style"
  },
  "drop": [
    "Number"
  ],
  "correct": {
    "Mohca": "Mocha"
  },
  "picture": {
    "by": "Club",
    "BPSC": "collections/bold-pups/images/{n5}.webp",
    "HHOC": "collections/hhoc/images/{n5}.webp"
  },
  "teaser": 8,
  "stat": {
    "total": "Pups",
    "traits": "Traits",
    "pictured": "Pictures online"
  },
  "all": "All",
  "app": {
    "app": "boldpups",
    "start": "home",
    "nav": [
      {
        "id": "home",
        "label": "Home",
        "icon": "home"
      },
      {
        "id": "collection",
        "label": "Collection",
        "icon": "grid"
      },
      {
        "id": "clubs",
        "label": "Clubs",
        "icon": "map"
      },
      {
        "id": "about",
        "label": "About",
        "icon": "file"
      }
    ],
    "views": {
      "home": {
        "title": "",
        "blocks": [
          {
            "kind": "hero",
            "heading": "BOLD PUPS",
            "subtitle": "{club.tagline}",
            "body": "{club.description}",
            "image": "$hero",
            "ratio": "1/1",
            "actions": [
              {
                "label": "See all {n}",
                "view": "collection"
              },
              {
                "label": "About the den",
                "view": "about"
              }
            ]
          },
          {
            "kind": "stats",
            "items": "$stats"
          },
          {
            "kind": "grid",
            "title": "Meet the den",
            "items": "$teaser",
            "toolbar": false,
            "layout": "grid",
            "ratio": "1/1",
            "mosaic": false,
            "cardFields": 0,
            "cols": 4,
            "minItemWidth": "12rem",
            "more": {
              "label": "See all {n}",
              "view": "collection"
            }
          },
          {
            "kind": "grid",
            "title": "Four of the sixteen clubs",
            "items": "$featured",
            "toolbar": false,
            "layout": "grid",
            "ratio": "16/10",
            "mosaic": false,
            "cardFields": 0,
            "cols": 4,
            "minItemWidth": "14rem",
            "more": {
              "label": "See all 16 clubs",
              "view": "clubs"
            }
          }
        ]
      },
      "collection": {
        "title": "The collection",
        "sub": "Every fox pup, all {n} of them, in both clubs: BOLD PUPS Space Club and HHOC. Filter by any trait, or search a number.",
        "blocks": [
          {
            "kind": "grid",
            "source": "$tokens",
            "filter": "$traits",
            "sort": [
              "title"
            ],
            "layout": "grid",
            "layoutSet": [
              "grid",
              "list"
            ],
            "ratio": "1/1",
            "mosaic": false,
            "pageSize": 48,
            "cardFields": 0,
            "cols": 6,
            "minItemWidth": "11rem"
          }
        ]
      },
      "clubs": {
        "title": "The 16 clubs",
        "sub": "The den spreads across the sixteen Bold Cities, one club to a city: each its own land, from the Forest to Bozo City, with its districts for shows, games and gathering. Open one to walk its views.",
        "blocks": [
          {
            "kind": "grid",
            "items": "$worlds",
            "filter": [
              "Land"
            ],
            "sort": [
              "title"
            ],
            "layout": "grid",
            "layoutSet": [
              "grid",
              "list"
            ],
            "ratio": "16/10",
            "mosaic": false,
            "cardFields": 0,
            "cols": 4,
            "minItemWidth": "15rem"
          }
        ]
      },
      "about": {
        "title": "About BOLD PUPS",
        "sub": "{club.tagline}",
        "blocks": [
          {
            "kind": "hero",
            "variant": "card",
            "heading": "The den",
            "body": "{club.description}",
            "image": "$hero"
          },
          {
            "kind": "stats",
            "items": "$stats"
          },
          {
            "kind": "grid",
            "title": "What a pup gets",
            "toolbar": false,
            "layout": "grid",
            "mosaic": false,
            "cols": 3,
            "minItemWidth": "16rem",
            "items": [
              {
                "title": "A place in the den",
                "body": "Each pup is a membership of BOLD PUPS: its host in Phiogy, its rooms to write and talk in, and its calls with camera and screen."
              },
              {
                "title": "Sixteen cities to live in",
                "body": "The Bold Cities are sixteen lands, from the Forest and the Desert to Once City and Bozo City; every club of the den keeps one."
              },
              {
                "title": "Shows on the Orbit runway",
                "body": "Pups walk the runway on Pup Orbit: shows, poses and renders of the den in its looks."
              },
              {
                "title": "Scavenger hunts and pool parties",
                "body": "Forage on scavenger hunts across the rings and gather for the Friday howl in Howl Arena."
              },
              {
                "title": "A share of the den fund",
                "body": "The pool behind the den: every fox pup holds a share of the den fund."
              },
              {
                "title": "Traits that count",
                "body": "Ten traits a pup, from fur to expression; open any pup to see how many of the 10,000 share each one."
              }
            ]
          },
          {
            "kind": "grid",
            "title": "The team",
            "toolbar": false,
            "layout": "grid",
            "ratio": "1/1",
            "mosaic": false,
            "cols": 4,
            "minItemWidth": "13rem",
            "items": [
              {
                "kind": "token",
                "id": "boldpups-1075",
                "title": "Rusty Vale",
