{
  "_": "The Epic Pods site (epicpods.xyz) as data. scripts/world-site.mjs fills the placeholders ($tokens, $teaser, $stats, $cities, {club.x}, {world.x}, {n}) from the trait sheet, Phiegg's club and world records and the media store, and writes public/data/epicpods.json. Edit here, then run: node scripts/world-site.mjs epicpods",
  "key": "epicpods",
  "club": "c_epac",
  "sheet": "media/incoming/epac/non-pixel.tsv",
  "token": {
    "number": "NUMBER",
    "title": "Epic Pod #{n}",
    "sub": "Rarity",
    "facet": "Rarity",
    "lead": "picture"
  },
  "field": {
    "BACKGROUND / RARTIRY": "Rarity",
    "CHAR": "Character",
    "HAIR": "Hair style",
    "HAT": "Hat",
    "ACCESSORY": "Accessory",
    "HAIR COLOUR": "Hair colour"
  },
  "drop": [
    "NUMBER"
  ],
  "correct": {
    "Monacle": "Monocle"
  },
  "picture": {
    "by": null,
    "all": "collections/bold-ape-epic-club/images/{n5}.webp"
  },
  "teaser": 8,
  "stat": {
    "total": "Pods",
    "traits": "Traits",
    "pictured": "Pictures online"
  },
  "all": "All",
  "app": {
    "app": "epicpods",
    "start": "home",
    "nav": [
      {
        "id": "home",
        "label": "Home",
        "icon": "home"
      },
      {
        "id": "collection",
        "label": "Collection",
        "icon": "grid"
      },
      {
        "id": "lore",
        "label": "Lore",
        "icon": "file"
      }
    ],
    "views": {
      "home": {
        "title": "",
        "blocks": [
          {
            "kind": "hero",
            "variant": "split",
            "heading": "epic pods",
            "body": "{club.tagline} {world.description}",
            "image": "cdn:epicpods/group/epicus-group-03.webp",
            "figures": [
              "cdn:epicpods/group/female-epic-07-group.webp",
              "cdn:epicpods/group/male-epic-03-group.webp"
            ],
            "actions": [
              {
                "label": "See all {n}",
                "view": "collection"
              },
              {
                "label": "Read the lore",
                "view": "lore"
              }
            ]
          },
          {
            "kind": "hero",
            "variant": "card",
            "heading": "Robots on the runway",
            "body": "The Epicus crew in chrome, posed in front of the bubble cars they race between the pods.",
            "image": "cdn:epicpods/group/epicus-group-01.webp"
          },
          {
            "kind": "hero",
            "variant": "card",
            "heading": "Four of a kind",
            "body": "Boldroids and Epics stand together: two robots, two pods, one teal stripe.",
            "image": "cdn:epicpods/group/boldroid-epics-group-02.webp",
            "flip": true
          },
          {
            "kind": "hero",
            "variant": "card",
            "heading": "Pink hour",
            "body": "The pink line arrives across the floral floor, last light on the hood.",
            "image": "cdn:epicpods/group/epicus-group-04.webp"
          },
          {
            "kind": "hero",
            "variant": "card",
            "heading": "The red line",
            "body": "Gloss red robots and the Epics who ride with them.",
            "image": "cdn:epicpods/group/boldroid-epics-group-03.webp",
            "flip": true
          },
          {
            "kind": "hero",
            "variant": "card",
            "heading": "Green light",
            "body": "A wave from the green crew before the start.",
            "image": "cdn:epicpods/group/epicus-group-02.webp"
          },
          {
            "kind": "hero",
            "variant": "card",
            "heading": "Silver season",
            "body": "Chrome and camo: the silver four from low down.",
            "image": "cdn:epicpods/group/boldroid-epics-group-04.webp",
            "flip": true
          },
          {
            "kind": "marquee",
            "items": [
              "train",
              "race",
              "trade",
              "pose",
              "gather"
            ]
          },
          {
            "kind": "grid",
            "title": "Every Epic, every outfit",
            "toolbar": false,
            "items": [
              {
                "title": "Epic 05",
                "image": "cdn:epicpods/group/epic-05-group.webp"
              },
              {
                "title": "Female Epic 07",
                "image": "cdn:epicpods/group/female-epic-07-group.webp"
              },
              {
                "title": "Male Epic 01",
                "image": "cdn:epicpods/group/male-epic-01-group.webp"
              },
              {
                "title": "Male Epic 03",
                "image": "cdn:epicpods/group/male-epic-03-group.webp"
              }
            ],
            "layout": "grid",
            "ratio": "4/5",
            "mosaic": false,
            "cardFields": 0,
            "cols": 4,
            "minItemWidth": "13rem"
          },
          {
            "kind": "stats",
            "items": "$stats"
          },
          {
            "kind": "grid",
            "title": "Meet the club",
            "items": "$teaser",
            "toolbar": false,
            "layout": "grid",
            "ratio": "1/1",
            "mosaic": false,
            "cardFields": 0,
            "cols": 4,
            "minItemWidth": "12rem",
            "more": {
              "label": "See all {n}",
              "view": "collection"
            }
          },
          {
            "kind": "hero",
            "variant": "wide",
            "heading": "1,024 pods. Pick yours.",
            "actions": [
              {
                "label": "See all {n}",
                "view": "collection"
              },
              {
                "label": "Read the lore",
                "view": "lore"
              }
            ]
          }
        ]
      },
      "collection": {
        "title": "The collection",
        "sub": "Every pod, all {n} of them, from Common to Legendary. Filter by any trait, or search a number. Each pod also has a pixel twin.",
        "blocks": [
          {
            "kind": "grid",
            "source": "$tokens",
            "filter": "$traits",
            "sort": [
              "title"
            ],
            "layout": "grid",
            "layoutSet": [
              "grid",
              "list"
            ],
            "ratio": "1/1",
            "mosaic": false,
            "pageSize": 48,
            "cardFields": 0,
            "cols": 6,
            "minItemWidth": "11rem"
          }
        ]
      },
      "lore": {
        "title": "{world.name}",
        "sub": "{club.tagline}",
        "blocks": [
          {
            "kind": "prose",
            "lead": "{world.description}",
            "sections": "$cities"
          }
        ]
      }
    }
  }
}
