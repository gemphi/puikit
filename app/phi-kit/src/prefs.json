{
  "_": "Settings, the same in every Phi app: its groups in order, each a choice a person makes once for every app. `kind` says what a group sets: `theme` (the colours, theme.json), `mode` (dark, light, auto: the system's), `surface` (how the parts are laid, surface.json), `radius` and `density` (the kit's corners and spacing), or `layout` (a choice kept by the kit's useLayout under `id` and put on the root, which every app's parts answer). An option's `mini` is its picture: a small window drawn as the choice lays it (`tabs` top or side, `feed` headings, partial or full, `swatch` its colours, `dark`). `mode` on a feed option is the list layout a feed opens in (ListView). `shared`: shown also inside an app's own Appearance (Phiegg's, the account's), under its rows; `replaces` names the rows of an app's own Appearance a shared group stands for, which that app then leaves out.",
  "head": {
    "title": "Settings",
    "sub": "Choose how every Phiace app looks and is laid out. Applies to every app on this device."
  },
  "groups": [
    {
      "id": "theme",
      "kind": "theme",
      "label": "Theme",
      "shared": true,
      "replaces": [
        "look",
        "palette",
        "accent"
      ]
    },
    {
      "id": "mode",
      "kind": "mode",
      "label": "Mode",
      "options": [
        {
          "value": "dark",
          "label": "Dark",
          "mini": {
            "dark": true,
            "swatch": [
              "#000000",
              "#1c1c1e"
            ]
          }
        },
        {
          "value": "light",
          "label": "Light",
          "mini": {
            "swatch": [
              "#f5f5f7",
              "#ffffff"
            ]
          }
        },
        {
          "value": "system",
          "label": "Auto",
          "mini": {
            "swatch": [
              "#000000",
              "#f5f5f7"
            ],
            "split": true
          }
        }
      ],
      "shared": true,
      "replaces": [
        "mode"
      ]
    },
    {
      "id": "surface",
      "kind": "surface",
      "label": "Surface",
      "shared": true,
      "replaces": [
        "gradient"
      ]
    },
    {
      "id": "radius",
      "kind": "radius",
      "label": "Corners",
      "shared": true,
      "replaces": [
        "radius"
      ]
    },
    {
      "id": "density",
      "kind": "density",
      "label": "Spacing",
      "options": [
        {
          "value": "0.9",
          "label": "Compact"
        },
        {
          "value": "1",
          "label": "Comfortable"
        },
        {
          "value": "1.15",
          "label": "Roomy"
        }
      ],
      "shared": true
    },
    {
      "id": "feed",
      "kind": "layout",
      "label": "Choose your preferred feed layout",
      "fallback": "full",
      "options": [
        {
          "value": "headings",
          "label": "Headings only",
          "mode": "list",
          "mini": {
            "feed": "headings"
          }
        },
        {
          "value": "partial",
          "label": "Partial feed",
          "mode": "tile",
          "mini": {
            "feed": "partial"
          }
        },
        {
          "value": "full",
          "label": "Full page",
          "mode": "grid",
          "mini": {
            "feed": "full"
          }
        }
      ],
      "shared": true
    },
    {
      "id": "tabs",
      "kind": "layout",
      "label": "Choose your preferred tab layout",
      "fallback": "horizontal",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal",
          "mini": {
            "tabs": "top"
          }
        },
        {
          "value": "vertical",
          "label": "Vertical",
          "mini": {
            "tabs": "side"
          }
        }
      ],
      "shared": true
    }
  ]
}
