{
  "_": "Settings, the same in every Phi app: its groups in order, each a choice a person makes once for every app. `kind` says what a group sets: `look` (looks.json), `mode` (light, dark, the system's), `layout` (a choice kept by the kit's useLayout under `id` and put on the root, which every app's parts answer), or one of the kit's own pickers (`palette`, `gradient`, `radius`, `density`). An option's `mini` is its picture: a small window drawn as the choice lays it (`tabs` top or side, `feed` headings, partial or full, `swatch` its colours, `dark`). `mode` on a feed option is the list layout a feed opens in (ListView). `shared`: shown also inside an app's own Appearance (Phiegg's), under its rows.",
  "head": {
    "title": "Settings",
    "sub": "Choose how every Phiace app looks and is laid out. Applies to every app on this device."
  },
  "groups": [
    {
      "id": "look",
      "kind": "look",
      "label": "Theme"
    },
    {
      "id": "mode",
      "kind": "mode",
      "label": "Light",
      "options": [
        {
          "value": "dark",
          "label": "Dark",
          "mini": {
            "dark": true,
            "swatch": [
              "#000000",
              "#1c1c1e"
            ]
          }
        },
        {
          "value": "light",
          "label": "Light",
          "mini": {
            "swatch": [
              "#f5f5f7",
              "#ffffff"
            ]
          }
        },
        {
          "value": "system",
          "label": "As the system",
          "mini": {
            "swatch": [
              "#000000",
              "#f5f5f7"
            ],
            "split": true
          }
        }
      ]
    },
    {
      "id": "feed",
      "kind": "layout",
      "label": "Choose your preferred feed layout",
      "fallback": "full",
      "options": [
        {
          "value": "headings",
          "label": "Headings only",
          "mode": "list",
          "mini": {
            "feed": "headings"
          }
        },
        {
          "value": "partial",
          "label": "Partial feed",
          "mode": "tile",
          "mini": {
            "feed": "partial"
          }
        },
        {
          "value": "full",
          "label": "Full page",
          "mode": "grid",
          "mini": {
            "feed": "full"
          }
        }
      ],
      "shared": true
    },
    {
      "id": "tabs",
      "kind": "layout",
      "label": "Choose your preferred tab layout",
      "fallback": "horizontal",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal",
          "mini": {
            "tabs": "top"
          }
        },
        {
          "value": "vertical",
          "label": "Vertical",
          "mini": {
            "tabs": "side"
          }
        }
      ],
      "shared": true
    },
    {
      "id": "palette",
      "kind": "palette",
      "label": "Palette"
    },
    {
      "id": "gradient",
      "kind": "gradient",
      "label": "Gradients"
    },
    {
      "id": "radius",
      "kind": "radius",
      "label": "Corners"
    },
    {
      "id": "density",
      "kind": "density",
      "label": "Density",
      "options": [
        {
          "value": "0.9",
          "label": "Compact"
        },
        {
          "value": "1",
          "label": "Comfortable"
        },
        {
          "value": "1.15",
          "label": "Roomy"
        }
      ]
    }
  ]
}
