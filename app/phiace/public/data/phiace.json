    "about": {
      "title": "About Phiace",
      "sub": "",
      "blocks": [
        {
          "kind": "prose",
          "lead": "Phiace is the assistant that ties the ecosystem together — chat, personas and a durable memory.",
          "sections": [
            {
              "title": "Assistant",
              "body": "One conversation that can reach into every app you have installed."
            },
            {
              "title": "Personas",
              "body": "Build character voices with their own knowledge and share them to clubs."
            },
            {
              "title": "Memory",
              "body": "A private, searchable record of your actions, items and conversations."
            }
          ]
        }
      ]
    },
    "faq": {
      "title": "FAQ",
      "sub": "Common questions.",
      "blocks": [
        {
          "kind": "faq",
          "items": [
            {
              "q": "Is my memory private?",
              "a": "Yes — it is yours, searchable only by you unless you share a persona."
            },
            {
              "q": "Can personas act?",
              "a": "They can run functions you approve, like Phient."
            },
            {
              "q": "Where does it run?",
              "a": "On local models by default, the same runner as Phient."
            },
            {
              "q": "Who can see my memory?",
              "a": "Only you, unless you share a part of it with a club.",
              "gen": true
            },
            {
              "q": "Can a persona act for me?",
              "a": "Only in the apps and limits you set in delegation.",
              "gen": true
            },
            {
              "q": "Can I export my memory?",
              "a": "Yes. Export it as a file from Memory at any time.",
              "gen": true
            },
            {
              "q": "How do I build a persona?",
              "a": "Open Personas, choose New and follow the steps.",
              "gen": true
            },
            {
              "q": "Do personas cost anything?",
              "a": "Making one is free. Renting someone else's has a price set by its owner.",
              "gen": true
            }
          ]
        }
      ]
    },
    "platform": {
      "title": "Platform",
      "sub": "The agents behind your assistant: PhiRAG remembers and answers, PhiMen plans.",
      "blocks": [
