    "apply": {
      "title": "Apply",
      "sub": "Two ways in. Pick the one that fits where your team is.",
      "blocks": [
        {
          "kind": "grid",
          "toolbar": false,
          "items": [
            {
              "title": "A Phipad cohort",
              "body": "Twelve weeks with mentors and players, EGG from Phisum, and Demo Day.",
              "pointList": [
                "EGG from the Phisum programme",
                "Mentors and playtests",
                "A slot at Demo Day"
              ]
            },
            {
              "title": "Straight to Phiegg",
              "body": "Already built and funded? Open a host on Phiegg and list your world today, no cohort needed.",
              "pointList": [
                "Open a host",
                "List your world",
                "Join the clubs"
              ]
            }
          ]
        },
        {
          "kind": "form",
          "heading": "Apply to a cohort",
          "sub": "Four steps. Everything can be changed before you send it.",
          "createKind": "application",
          "set": {
            "programme": "phisum"
          },
          "submitLabel": "Send the application",
          "doneTitle": "Application sent",
          "done": "Thank you. Applications are read every week; a reply comes to your Phiegg messages.",
          "againLabel": "Start another",
          "steps": [
            {
              "id": "team",
              "label": "Team",
              "icon": "users",
              "title": "The team",
              "lede": "Who you are and the track you are applying to.",
              "fields": [
                {
                  "id": "name",
                  "label": "Team or club name",
                  "required": true
                },
                {
                  "id": "track",
                  "label": "Track",
                  "control": "select",
                  "options": [
                    "Virtual worlds",
                    "Agentic worlds",
                    "AR",
                    "Avatars and identity"
                  ],
                  "required": true
                },
                {
                  "id": "people",
                  "label": "Who is on the team, and what each person does",
                  "control": "textarea",
                  "full": true,
                  "required": true
                },
                {
                  "id": "near",
                  "label": "NEAR account (optional)",
                  "placeholder": "yourname.near",
                  "hint": "Where EGG goes once it is live. You can add it later."
                }
              ]
            },
            {
              "id": "world",
              "label": "World",
              "icon": "map",
              "title": "The world",
              "lede": "What you are building and how far it has come.",
              "fields": [
                {
                  "id": "world",
                  "label": "The world, in a few lines",
                  "control": "textarea",
                  "full": true,
                  "required": true
                },
                {
                  "id": "players",
                  "label": "What people do there",
                  "control": "textarea",
                  "full": true
                },
                {
                  "id": "stage",
                  "label": "How far along",
                  "control": "select",
                  "options": [
                    "An idea",
                    "A prototype",
                    "Playable",
                    "Live"
                  ],
                  "required": true
                },
                {
                  "id": "link",
                  "label": "A link to see it",
                  "full": true
                }
              ]
            },
            {
              "id": "video",
              "label": "Video",
              "icon": "spark",
              "title": "Video",
              "lede": "Two minutes, the team on camera, saying what you are building and why.",
              "fields": [
                {
                  "id": "video",
                  "label": "Link to the video",
                  "full": true,
                  "required": true
                },
                {
                  "id": "terms",
                  "label": "I understand the terms are set per cohort and published before it opens, and that nothing here is an offer.",
                  "control": "consent",
                  "required": true,
                  "full": true
                }
              ]
            },
            {
              "id": "review",
              "label": "Review",
              "icon": "clipboard",
              "title": "Review",
              "lede": "Check what you wrote, then send it.",
              "review": true
            }
          ]
        }
      ]
    },
    "near": {
      "title": "Your NEAR account",
      "sub": "Connect the account EGG should go to once it is a NEAR token. Connecting only reads which account is yours.",
      "blocks": [
        {
          "kind": "near"
        },
        {
          "kind": "prose",
          "sections": [
            {
              "title": "No wallet yet?",
              "body": "You do not need one to apply. When you do want one, NEAR wallets such as Meteor, Intear and Nightly make an account in a few minutes; the connect button lists them."
            },
            {
              "title": "EGG on NEAR",
              "body": "EGG is planned as a NEAR fungible token (NEP-141). Phisum sets out where that stands."
            }
          ]
        }
      ]
    },
    "faq": {
      "title": "FAQ",
      "sub": "About applying and the cohorts. Questions about the fund and EGG are answered on Phisum.",
      "blocks": [
        {
          "kind": "faq",
          "items": [
            {
              "q": "Who can apply?",
              "a": "Any team, from one founder up, building a world people can enter. You do not need to be funded or incorporated."
            },
            {
              "q": "Is there a deadline?",
              "a": "Applications are rolling and read every week. Each cohort has a closing date, announced here; a later application is considered for the next one."
            },
            {
              "q": "Is it in person?",
              "a": "No. The cohort is remote, and Demo Day is online."
            },
            {
              "q": "How much time does it take?",
              "a": "Plan on the cohort being your main work for twelve weeks: office hours once a week, a review at week six, and Demo Day."
            },
            {
              "q": "We already have a token or funding. Can we apply?",
              "a": "Yes. Say so in the application. If you only need a host on Phiegg, take the direct route instead."
            },
            {
              "q": "What is in the video?",
              "a": "Two minutes, the team on camera, saying what you are building and why. A phone recording is fine."
            },
            {
              "q": "Do we have to launch on Phiegg?",
              "a": "Cohort teams get a place on the Phiegg map and use its hosts, drops and wallet. Where else the world lives is yours to decide."
            },
            {
              "q": "What does a team get, and on what terms?",
              "a": "EGG from Phisum, the virtual world fund, on terms it publishes per cohort. Phisum sets them out."
            },
            {
              "q": "What happens after Demo Day?",
              "a": "Teams become alumni: they keep their place on the map, their mentors and the community."
            }
          ]
        }
      ]
    },
    "about": {
      "title": "About Phipad",
      "blocks": [
        {
          "kind": "prose",
          "lead": "Phipad is the accelerator for teams building virtual worlds, and the way into Phisum, the virtual world fund.",
          "sections": [
            {
              "title": "What we look for",
              "body": "Worlds people will come back to: places with something to do, someone to meet and a reason to return. Four tracks: virtual worlds, agentic worlds, AR, and avatars and identity."
            },
            {
              "title": "How a cohort runs",
              "body": "Twelve weeks, remote. Teams set their milestones in week one, build with mentors and Phiegg players, and show their worlds at Demo Day."
            },
            {
              "title": "The direct route",
              "body": "Already built? Open a host on Phiegg and list your world today, with no cohort needed."
            }
          ]
        }
      ]
    }
  }
